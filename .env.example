# Copy to .env and fill in values before `docker compose up`.
# Find the Mongo network with: docker network ls

# Browser-facing API URL baked into the frontend at build time
VITE_API_URL=https://api.holdmymail.app

# Used in auth/digest emails
FRONTEND_URL=https://holdmymail.app

# Server-side frontend requests from inside Docker
INTERNAL_API_URL=http://holdmymail-api:2910

# Reachable from the backend container (service name `mongodb` on MONGO_NETWORK)
MONGODB_URI=mongodb://mongodb:27017/holdmymail

ADMIN_USERNAMES=
ADMIN_EMAILS=

